# python
__pycache__/
*.py[cod]
.venv/
# a second environment beside uv's, e.g. `python -m venv .venv-pip` (#116)
.venv-*/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# secrets
.env

# rebuildable artifacts (keep the directory itself so a fresh clone can write into it)
indexes/*
!indexes/.gitkeep
*.pkl

# chunks are rebuilt from the committed data/*.json by `uv run python -m ingest.chunk`, with no
# private input and no API key -- unlike those files, whose source CSV is not in the repo. A
# template change rewrites all 3 MB, so keeping them out spares git the churn.
data/chunks.jsonl
data/chunks.meta.json

# stand-in drafts: rows canned by `--fake-model` with no model behind them (#56). The real
# drafts beside them are committed, because #59 verifies them and #62 reports what they became.
eval/datasets/drafts/*.standin.jsonl
eval/datasets/drafts/*.standin.meta.json

# os / editor
.DS_Store
.vscode/
.idea/
